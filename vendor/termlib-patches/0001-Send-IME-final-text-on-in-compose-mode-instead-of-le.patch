From d4763a76808eb5b6d0376cbf71f4b4d886c3531b Mon Sep 17 00:00:00 2001
From: XueshiQiao <qiaoxueshi@gmail.com>
Date: Sat, 31 Oct 2026 16:51:00 +0800
Subject: [PATCH 1/2] Send IME-final text on in compose mode instead of leaving
 it in the overlay

A CJK IME that accepts a candidate with finishComposingText() left the
text in the compose buffer, shown in the overlay as if typed; the Space
or Enter that followed reached the terminal ahead of it, and a Space the
IME sent as a key event was buffered too. Nothing reached the shell until
compose mode was toggled off.

The buffer now mirrors only the IME's live composing region: finishing
the composition flushes it, committed text flushes it first so order is
kept, and a key the IME sends with no composition in progress goes to the
terminal. Hardware keys still buffer as before.
---
 .../org/connectbot/terminal/ImeInputView.kt   |  14 +-
 .../connectbot/terminal/KeyboardHandler.kt    |  31 +++-
 .../terminal/ComposeModeImeCommitTest.kt      | 175 ++++++++++++++++++
 3 files changed, 217 insertions(+), 3 deletions(-)
 create mode 100644 lib/src/test/java/org/connectbot/terminal/ComposeModeImeCommitTest.kt

diff --git a/lib/src/main/java/org/connectbot/terminal/ImeInputView.kt b/lib/src/main/java/org/connectbot/terminal/ImeInputView.kt
index 5b5e9129..a0e9c4b9 100644
--- a/lib/src/main/java/org/connectbot/terminal/ImeInputView.kt
+++ b/lib/src/main/java/org/connectbot/terminal/ImeInputView.kt
@@ -448,6 +448,10 @@ internal class ImeInputView(
             if (!fullEditor) return super.finishComposingText()
 
             super.finishComposingText()
+            // The IME has accepted its composition as typed. The projected copy lives in the
+            // compose buffer, so send it on; left there it showed in the overlay as though
+            // typed, while the Space or Enter that followed went to the terminal ahead of it.
+            if (composingText.isNotEmpty()) keyboardHandler.flushComposeBuffer()
             composingText = ""
             trimEditableContext()
             committedContext = editable?.toString().orEmpty()
@@ -495,7 +499,15 @@ internal class ImeInputView(
                 // Compose mode (TYPE_CLASS_TEXT): route through dispatchKeyEvent so the
                 // setOnKeyListener chain handles it. Clear the editable buffer afterward so
                 // Gboard does not accumulate terminal input as suggestion candidates.
-                val result = this@ImeInputView.dispatchKeyEvent(event)
+                // With no composition in progress the key is final input, not more of a
+                // composition, so it must not be buffered (see KeyboardHandler.dispatchingImeKey).
+                val bypass = composingText.isEmpty()
+                if (bypass) keyboardHandler.dispatchingImeKey = true
+                val result = try {
+                    this@ImeInputView.dispatchKeyEvent(event)
+                } finally {
+                    if (bypass) keyboardHandler.dispatchingImeKey = false
+                }
                 if (isKeyDown) {
                     awaitingPostEnterCommitReplay = event.keyCode == KeyEvent.KEYCODE_ENTER
                     postEnterSubmittedText = postEnterSubmittedBeforeDispatch
diff --git a/lib/src/main/java/org/connectbot/terminal/KeyboardHandler.kt b/lib/src/main/java/org/connectbot/terminal/KeyboardHandler.kt
index dd1a84e0..6c9e07f3 100644
--- a/lib/src/main/java/org/connectbot/terminal/KeyboardHandler.kt
+++ b/lib/src/main/java/org/connectbot/terminal/KeyboardHandler.kt
@@ -105,6 +105,15 @@ internal class KeyboardHandler(
     var pendingDeadChar: Int by mutableStateOf(0)
         internal set
 
+    /**
+     * Set while a key the IME sent through its InputConnection is dispatched. Such a key is
+     * already final as far as the IME is concerned — it composes in its own region, which is
+     * what the compose buffer mirrors — so it flushes the buffer and goes to the terminal
+     * rather than being buffered like a hardware key. Without this, a Space from a CJK IME
+     * vanished into the overlay and stayed there until compose mode was toggled off.
+     */
+    internal var dispatchingImeKey: Boolean = false
+
     /**
      * Process a Compose KeyEvent and send to terminal.
      * Returns true if the event was handled.
@@ -139,7 +148,10 @@ internal class KeyboardHandler(
 
         // Buffer text while composing, but let terminal commands use the normal key path.
         val compose = composeMode
-        if (compose != null && compose.isActive) {
+        if (compose != null && compose.isActive && dispatchingImeKey) {
+            if (AndroidKeyEvent.isModifierKey(nativeEvent.keyCode)) return false
+            flushComposition()
+        } else if (compose != null && compose.isActive) {
             if (AndroidKeyEvent.isModifierKey(nativeEvent.keyCode)) return false
             val modifiers = buildModifierMask(ctrl, alt, shift)
             val terminalShortcut = modifiers and TERMINAL_SHORTCUT_MODIFIERS != 0
@@ -333,6 +345,18 @@ internal class KeyboardHandler(
         composeMode?.commit()?.let { sendText(0, it, false) }
     }
 
+    /**
+     * Send whatever the compose buffer holds to the terminal now. Called when the IME finishes
+     * its composition without committing it (finishComposingText), which many CJK IMEs do to
+     * accept a candidate: the text is final, and must not wait in the overlay while the next
+     * Space or Enter reaches the terminal ahead of it.
+     */
+    internal fun flushComposeBuffer() {
+        val text = composeMode?.commit() ?: return
+        sendText(0, text, false)
+        onInputProcessed?.invoke()
+    }
+
     /**
      * Process text input from IME (Input Method Editor).
      * This handles multi-byte UTF-8 text from the software keyboard.
@@ -376,7 +400,10 @@ internal class KeyboardHandler(
             Normalizer.normalize(text, Normalizer.Form.NFC)
         }
         val modifiers = getModifierMask()
-        if (composeMode?.isActive == true && modifiers and TERMINAL_SHORTCUT_MODIFIERS != 0) {
+        // Anything still in the buffer was typed before this text, so it goes first. A
+        // commit that replaces the IME's own composition has already deleted the projected
+        // copy from the buffer, so this sends only text that is really pending.
+        if (composeMode?.isActive == true) {
             flushComposition()
         }
 
