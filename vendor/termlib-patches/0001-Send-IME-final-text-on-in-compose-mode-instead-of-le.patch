+package org.connectbot.terminal
+
+import android.content.Context
+import android.view.KeyEvent
+import android.view.inputmethod.EditorInfo
+import android.view.inputmethod.InputConnection
+import android.view.inputmethod.InputMethodManager
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+
+/**
+ * In compose mode the local buffer mirrors the IME's composing region and
+ * nothing else from the IME: once the IME considers text final it must reach
+ * the terminal, in the order it was typed. Otherwise a Chinese or Japanese
+ * IME that finishes a candidate with finishComposingText() leaves the text in
+ * the overlay, and the Space or Enter that follows reaches the shell ahead of
+ * it — the text looks typed but is not, until compose mode is toggled off.
+ */
+@RunWith(AndroidJUnit4::class)
+class ComposeModeImeCommitTest {
+
+    private val context get() = InstrumentationRegistry.getInstrumentation().targetContext
+
+    private class Capture(val ic: InputConnection, val outputs: MutableList<ByteArray>, val composeMode: ComposeMode)
+
+    private fun capture(): Capture {
+        val outputs = mutableListOf<ByteArray>()
+        val composeMode = ComposeMode().also { it.activate() }
+        val emulator = TerminalEmulatorFactory.create(
+            initialRows = 24,
+            initialCols = 80,
+            onKeyboardInput = { data -> outputs.add(data.copyOf()) },
+        )
+        val handler = KeyboardHandler(emulator).also {
+            it.composeMode = composeMode
+            it.unicodeCharLookup = { _, keyCode, _ ->
+                when (keyCode) {
+                    KeyEvent.KEYCODE_SPACE -> ' '.code
+                    KeyEvent.KEYCODE_A -> 'a'.code
+                    else -> 0
+                }
+            }
+        }
+        var ic: InputConnection? = null
+        InstrumentationRegistry.getInstrumentation().runOnMainSync {
+            val view = ImeInputView(
+                context = context,
+                keyboardHandler = handler,
+                inputMethodManager = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager,
+                onRestartInput = {},
+            )
+            view.isComposeModeActive = true
+            // As Terminal wires it.
+            view.setOnKeyListener { _, _, event -> view.handleRawKeyEvent(event) }
+            ic = view.onCreateInputConnection(EditorInfo())
+        }
+        return Capture(ic!!, outputs, composeMode)
+    }
+
+    private fun Capture.run(block: InputConnection.() -> Unit) {
+        InstrumentationRegistry.getInstrumentation().runOnMainSync { ic.block() }
+        InstrumentationRegistry.getInstrumentation().waitForIdleSync()
+    }
+
+    /** What the shell has been sent, with DEL/BS applied per code point and
+     * CR shown as \n. */
+    private fun Capture.sent(): String {
+        val text = outputs.fold(ByteArray(0)) { a, b -> a + b }.toString(Charsets.UTF_8)
+        val out = StringBuilder()
+        text.codePoints().forEach { cp ->
+            when (cp) {
+                0x7F, 0x08 -> if (out.isNotEmpty()) out.setLength(out.offsetByCodePoints(out.length, -1))
+                0x0D, 0x0A -> out.append('\n')
+                else -> if (cp >= 0x20) out.appendCodePoint(cp)
+            }
+        }
+        return out.toString()
+    }
+
+    private fun key(code: Int) = KeyEvent(KeyEvent.ACTION_DOWN, code)
+
+    @Test
+    fun finishComposingTextSendsTheComposition() {
+        val c = capture()
+        c.run {
+            setComposingText("ni", 1)
+            setComposingText("你好", 1)
+            finishComposingText()
+        }
+        assertEquals("你好", c.sent())
+        assertEquals("", c.composeMode.buffer)
+    }
+
+    @Test
+    fun spaceCommittedAfterAFinishedCompositionFollowsIt() {
+        val c = capture()
+        c.run {
+            setComposingText("你好", 1)
+            finishComposingText()
+            commitText(" ", 1)
+        }
+        assertEquals("你好 ", c.sent())
+    }
+
+    @Test
+    fun spaceKeyFromTheImeReachesTheShell() {
+        val c = capture()
+        c.run {
+            commitText("你好", 1)
+            sendKeyEvent(key(KeyEvent.KEYCODE_SPACE))
+        }
+        assertEquals("你好 ", c.sent())
+        assertEquals("", c.composeMode.buffer)
+    }
+
+    @Test
+    fun enterCommittedAsTextAfterAFinishedCompositionFollowsIt() {
+        val c = capture()
+        c.run {
+            setComposingText("你好", 1)
+            finishComposingText()
+            commitText("\n", 1)
+        }
+        assertEquals("你好\n", c.sent())
+    }
+
+    @Test
+    fun enterKeyAfterAFinishedCompositionFollowsIt() {
+        val c = capture()
+        c.run {
+            setComposingText("你好", 1)
+            finishComposingText()
+            sendKeyEvent(key(KeyEvent.KEYCODE_ENTER))
+        }
+        assertEquals("你好\n", c.sent())
+    }
+
+    @Test
+    fun aLiveCompositionStaysInTheOverlay() {
+        val c = capture()
+        c.run { setComposingText("nihao", 1) }
+        assertEquals("", c.sent())
+        assertEquals("nihao", c.composeMode.buffer)
+    }
+
+    @Test
+    fun committingACandidateReplacesTheComposition() {
+        val c = capture()
+        c.run {
+            setComposingText("nihao", 1)
+            commitText("你好", 1)
+        }
+        assertEquals("你好", c.sent())
+        assertEquals("", c.composeMode.buffer)
+    }
+}
